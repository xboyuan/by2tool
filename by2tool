self_update() {
  if [[ -z "$UPDATE_SOURCE" ]]; then
    echo "未配置 UPDATE_SOURCE，无法自动更新。"
    echo "可以在脚本顶部设置 UPDATE_SOURCE，或执行：$0 --mode update --update-source <URL或文件路径>"
    echo "步骤完成：更新检查结束，未执行更新"
    return 2
  fi

  local self tmp backup
  self="$(readlink -f "$0")"
  tmp="$(mktemp)"
  backup="${self}.bak.$(date +%Y%m%d%H%M%S)"

  echo "更新源：$UPDATE_SOURCE"
  case "$UPDATE_SOURCE" in
    http://*|https://*)
      if command -v curl >/dev/null 2>&1; then
        curl -fsSL "$UPDATE_SOURCE" -o "$tmp"
      elif command -v wget >/dev/null 2>&1; then
        wget -qO "$tmp" "$UPDATE_SOURCE"
      else
        echo "缺少 curl 或 wget，无法从 URL 更新。" >&2
        rm -f "$tmp"
        return 127
      fi
      ;;
    *)
      if [[ ! -f "$UPDATE_SOURCE" ]]; then
        echo "更新源文件不存在：$UPDATE_SOURCE" >&2
        rm -f "$tmp"
        return 66
      fi
      cp "$UPDATE_SOURCE" "$tmp"
      ;;
  esac

  if ! bash -n "$tmp"; then
    echo "新脚本语法检查失败，已取消更新。" >&2
    rm -f "$tmp"
    return 65
  fi

  cp "$self" "$backup"
  cp "$tmp" "$self"
  chmod +x "$self"
  rm -f "$tmp"
  echo "脚本已更新，备份文件：$backup"
  echo "步骤完成：脚本更新完成"
}

ask() {
  local prompt="$1"
  local default="$2"
  local value
  if [[ -n "$default" ]]; then
    printf '%s [%s]: ' "$prompt" "$default" >&2
  else
    printf '%s: ' "$prompt" >&2
  fi
  if ! IFS= read -r value; then
    echo
    return 1
  fi
  printf '%s' "${value:-$default}"
}

ask_yes_no() {
  local prompt="$1"
  local default="$2"
  local answer
  while true; do
    answer="$(ask "$prompt" "$default")" || return 1
    case "${answer,,}" in
      y|yes|是|true) return 0 ;;
      n|no|否|false) return 1 ;;
      *) echo "请输入 y 或 n" ;;
    esac
  done
}

