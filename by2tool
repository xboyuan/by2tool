    printf '镜像清单文件：%s' "$IMAGE_LIST"
    return
  fi

  if [[ -n "$REGISTRY_PREFIX" ]]; then
    printf '仓库/项目前缀：%s*' "$REGISTRY_PREFIX"
  else
    printf '所有带 / 的镜像'
  fi
}

describe_export_source() {
