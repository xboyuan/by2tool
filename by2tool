plain_select_menu() {
  local title="$1"
  shift
  local options=("$@")
  local choice

  center_text_line 68 "$title" >&2
  local i
  for i in "${!options[@]}"; do
    printf '  %d) %s\n' "$((i + 1))" "${options[$i]}" >&2
  done

  while true; do
    choice="$(ask "请选择" "1")" || return 1
    if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#options[@]} )); then
      printf '%s' "$choice"
      return 0
    fi
    if [[ "${choice,,}" == "q" ]]; then
      printf '%s' "${#options[@]}"
      return 0
    fi
    echo "无效选择" >&2
  done
}

cursor_select_menu() {
  local title="$1"
  shift
  local options=("$@")
  local selected=0
  local key

  exec 3</dev/tty 4>/dev/tty
  tput civis >&4 2>/dev/null || true
  trap 'tput cnorm >&4 2>/dev/null || true; exec 3<&- 4>&-; trap - RETURN' RETURN

  printf '%b\n' "$C_BOLD" >&4
  center_text_line 68 "$title" >&4
  printf '%b' "$C_RESET" >&4
  printf '%s↑/↓ 选择，Enter 确认，q 退出%s\n\n' "$C_DIM" "$C_RESET" >&4

  render_cursor_options() {
    local i
    for i in "${!options[@]}"; do
      printf '\r\033[2K' >&4
      if (( i == selected )); then
        printf '  %s> %s%s\n' "$C_REVERSE" "${options[$i]}" "$C_RESET" >&4
      else
        printf '    %s\n' "${options[$i]}" >&4
      fi
    done
  }

  render_cursor_options

  while true; do
    IFS= read -rsn1 key <&3 || return 1
    case "$key" in
      $'\x1b')
        IFS= read -rsn2 -t 0.1 key <&3 || { printf '%s' "${#options[@]}"; return 0; }
        case "$key" in
          '[A') ((selected--)); (( selected < 0 )) && selected=$((${#options[@]} - 1)) ;;
          '[B') ((selected++)); (( selected >= ${#options[@]} )) && selected=0 ;;
        esac
        printf '\033[%sA' "${#options[@]}" >&4
        render_cursor_options
        ;;
      '')
        printf '\n' >&4
        printf '%s' "$((selected + 1))"
        return 0
        ;;
      q|Q)
        printf '\n' >&4
        printf '%s' "${#options[@]}"
        return 0
        ;;
    esac
  done
}

select_menu() {
  local title="$1"
  shift
  if [[ -t 0 && -r /dev/tty && -w /dev/tty ]]; then
    cursor_select_menu "$title" "$@"
  else
    plain_select_menu "$title" "$@"
  fi
}

plain_multi_select_menu() {
  local title="$1"
  shift
  local options=("$@")
  local input
  local normalized
  local value
  local values=()
  local seen=","

  center_text_line 68 "$title" >&2
  local i
  for i in "${!options[@]}"; do
    printf '  %d) %s\n' "$((i + 1))" "${options[$i]}" >&2
  done

  while true; do
    input="$(ask "请输入序号，多个用逗号分隔，q 返回" "")" || return 1
    [[ "${input,,}" == "q" ]] && return 1
    normalized="${input//,/ }"
    read -r -a values <<< "$normalized"

    local valid=true
    local selected_values=()
    seen=","
    for value in "${values[@]}"; do
      if [[ ! "$value" =~ ^[0-9]+$ ]] || (( value < 1 || value > ${#options[@]} )); then
        valid=false
        break
      fi
      if [[ "$seen" != *",$value,"* ]]; then
        selected_values+=("$value")
        seen+="$value,"
      fi
    done

    if [[ "$valid" == true && ${#selected_values[@]} -gt 0 ]]; then
      printf '%s\n' "${selected_values[@]}"
      return 0
    fi
    echo "请选择至少一个有效序号" >&2
  done
}

cursor_multi_select_menu() {
  local title="$1"
  shift
  local options=("$@")
  local current=0
  local key
  local selected=()
  local i
  for i in "${!options[@]}"; do selected+=(false); done

  exec 3</dev/tty 4>/dev/tty
  tput civis >&4 2>/dev/null || true
  trap 'tput cnorm >&4 2>/dev/null || true; exec 3<&- 4>&-; trap - RETURN' RETURN

  printf '%b\n' "$C_BOLD" >&4
  center_text_line 68 "$title" >&4
  printf '%b' "$C_RESET" >&4
  printf '%s↑/↓ 移动，Space 勾选，Enter 确认，q 返回%s\n\n' "$C_DIM" "$C_RESET" >&4

  render_multi_select_options() {
    local index
    local mark
    for index in "${!options[@]}"; do
      [[ "${selected[$index]}" == true ]] && mark="[x]" || mark="[ ]"
      printf '\r\033[2K' >&4
      if (( index == current )); then
        printf '  %s> %s %s%s\n' "$C_REVERSE" "$mark" "${options[$index]}" "$C_RESET" >&4
      else
        printf '    %s %s\n' "$mark" "${options[$index]}" >&4
      fi
    done
  }

  render_multi_select_options

  while true; do
    IFS= read -rsn1 key <&3 || return 1
    case "$key" in
      $'\x1b')
        IFS= read -rsn2 -t 0.1 key <&3 || return 1
        case "$key" in
          '[A') ((current--)); (( current < 0 )) && current=$((${#options[@]} - 1)) ;;
          '[B') ((current++)); (( current >= ${#options[@]} )) && current=0 ;;
        esac
        printf '\033[%sA' "${#options[@]}" >&4
        render_multi_select_options
        ;;
      ' ')
        if [[ "${selected[$current]}" == true ]]; then
          selected[$current]=false
        else
          selected[$current]=true
        fi
        printf '\033[%sA' "${#options[@]}" >&4
        render_multi_select_options
        ;;
      '')
        local selected_count=0
        for i in "${!selected[@]}"; do
          [[ "${selected[$i]}" == true ]] && selected_count=$((selected_count + 1))
        done
        if (( selected_count == 0 )); then
          continue
        fi
        printf '\n' >&4
        for i in "${!selected[@]}"; do
          [[ "${selected[$i]}" == true ]] && printf '%s\n' "$((i + 1))"
        done
        return 0
        ;;
      q|Q)
        printf '\n' >&4
        return 1
        ;;
    esac
  done
}

multi_select_menu() {
  local title="$1"
  shift
  if [[ -t 0 && -r /dev/tty && -w /dev/tty ]]; then
    cursor_multi_select_menu "$title" "$@"
  else
    plain_multi_select_menu "$title" "$@"
  fi
}

