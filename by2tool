}



center_text_line() {
  local width="$1"
  local text="$2"
  local len=${#text}
  local pad=0
  if (( width > len )); then
    pad=$(((width - len) / 2))
  fi
  printf '%*s%s\n' "$pad" '' "$text"
}

border_text_line() {
  local width="$1"
  local text="$2"
  local len=${#text}
  local left=0
  local right=0
  if (( width > len )); then
    left=$(((width - len) / 2))
    right=$((width - len - left))
  fi
  printf '%b║%*s%s%*s║%b\n' "$C_CYAN" "$left" '' "$text" "$right" '' "$C_RESET"
}

border_blank_line() {
  local width="$1"
  printf '%b║%*s║%b\n' "$C_CYAN" "$width" '' "$C_RESET"
}

