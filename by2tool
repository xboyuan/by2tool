restore_tags() {
  [[ "$RESTORE_AFTER_EXPORT" == true ]] || return 0
  [[ "$DRY_RUN" == false ]] || return 0
  [[ -s "$EXPORT_LIST" ]] || return 0

  local restore_total
  local restore_current=0
  restore_total=$(wc -l < "$EXPORT_LIST" | tr -d ' ')
  log "restoring exported image tags to $RESTORE_PLATFORM"
  while IFS= read -r image; do
    [[ -n "$image" ]] || continue
    restore_current=$((restore_current + 1))
    render_export_progress "$restore_current" "$restore_total" "恢复本机镜像：$RESTORE_PLATFORM" "镜像" "$image"
    log_only "restore $image"
    if ! docker pull --platform "$RESTORE_PLATFORM" "$image" >> "$LOG" 2>&1; then
      log_only "restore_failed $image"
    fi
  done < "$EXPORT_LIST"
  step_done "本次导出镜像架构恢复流程结束：$RESTORE_PLATFORM"
}

export_images() {
  require_cmd docker
  require_cmd awk
  require_cmd sort
  require_cmd tee

  cd "$WORKDIR"

  : > "$LOG"
  : > "$EXPORT_LIST"
  : > "$SKIP_LIST"

  log "effective config:"
  print_config | tee -a "$LOG"

  if [[ -n "$IMAGE_LIST" ]]; then
    log "using image list: $IMAGE_LIST"
    sort -u "$IMAGE_LIST" > "$ALL_LIST"
  else
    log "generating image list from docker compose config"
    docker compose config | awk '/image:/ {print $2}' | sort -u > "$ALL_LIST"
  fi

  local total
  total=$(wc -l < "$ALL_LIST" | tr -d ' ')
  log "image count: $total"
  step_done "镜像列表已生成，共 $total 个镜像"

  local candidates=()
  while IFS= read -r image; do
    [[ -n "$image" ]] || continue

    if ! is_registry_image "$image"; then
      append_skip "$image" "not matched by REGISTRY_PREFIX or local short-name image"
      continue
    fi

    if is_excluded_image "$image"; then
      append_skip "$image" "matched EXCLUDE_IMAGES"
      continue
    fi

    candidates+=("$image")
  done < "$ALL_LIST"

  local candidate_total=${#candidates[@]}
  local current=0
  log_only "matched image count: $candidate_total"

  for image in "${candidates[@]}"; do
    current=$((current + 1))

    if [[ "$DRY_RUN" == true ]]; then
      render_export_progress "$current" "$candidate_total" "预演导出：$PLATFORM" "镜像" "$image"
      log_only "dry-run would export $image as $PLATFORM"
      printf '%s\n' "$image" >> "$EXPORT_LIST"
      continue
    fi

    render_export_progress "$current" "$candidate_total" "拉取镜像：$PLATFORM" "镜像" "$image"
    log_only "pull $image as $PLATFORM"
    if docker pull --platform "$PLATFORM" "$image" >> "$LOG" 2>&1; then
      local actual
      actual=$(platform_of_image "$image" 2>/dev/null || true)
      if platform_matches "$actual" "$PLATFORM"; then
        printf '%s\n' "$image" >> "$EXPORT_LIST"
        log_only "ok $image => $actual"
      else
        append_skip "$image" "pulled platform is ${actual:-unknown}, expected $PLATFORM"
      fi
    else
      append_skip "$image" "docker pull --platform $PLATFORM failed"
    fi
  done

  local export_count
  export_count=$(wc -l < "$EXPORT_LIST" | tr -d ' ')

  if [[ "$DRY_RUN" == true ]]; then
    log "candidate image count: $export_count"
    log "dry-run complete; no image was pulled or saved"
    step_done "预演完成，未拉取镜像，未生成 tar"
    return 0
  fi

  log_only "exportable image count: $export_count"

  if [[ "$export_count" -eq 0 ]]; then
    log "no exportable images"
    return 2
  fi

  mapfile -t images_to_save < "$EXPORT_LIST"
  rm -f "$OUT"
  if ! save_images_with_progress "$OUT" "${images_to_save[@]}"; then
    log "docker save failed: $OUT"
    return 2
  fi
  ls -lh "$OUT" >> "$LOG" 2>&1
  step_done "镜像包已生成：$OUT"
  restore_tags
  log_only "done"
}


safe_image_name() {
  local image="$1"
  image="${image//\//_}"
  image="${image//:/_}"
  image="${image//@/_}"
  printf '%s' "$image"
}

export_one_image() {
  require_cmd docker
  require_cmd awk
  require_cmd tee

  cd "$WORKDIR"

  if [[ -z "$SINGLE_IMAGE" ]]; then
    echo "未指定 SINGLE_IMAGE。请使用 --image，或在交互菜单里选择/输入镜像。" >&2
    return 64
  fi

  local safe_name
  safe_name="$(safe_image_name "$SINGLE_IMAGE")"
  OUT="${OUT:-single_${safe_name}_${PLATFORM_SUFFIX}.tar}"
  EXPORT_LIST="${EXPORT_LIST:-single_${PLATFORM_SUFFIX}_export_images.list}"
  SKIP_LIST="${SKIP_LIST:-single_${PLATFORM_SUFFIX}_skipped_images.list}"
  LOG="${LOG:-single_${PLATFORM_SUFFIX}_export.log}"

  : > "$LOG"
  : > "$EXPORT_LIST"
  : > "$SKIP_LIST"

  log "effective config:"
  print_config | tee -a "$LOG"

  if [[ "$DRY_RUN" == true ]]; then
    render_export_progress 1 1 "单镜像预演：$PLATFORM" "镜像" "$SINGLE_IMAGE"
    log_only "dry-run would export $SINGLE_IMAGE as $PLATFORM"
    printf '%s\n' "$SINGLE_IMAGE" > "$EXPORT_LIST"
    step_done "单镜像导出预演完成，未拉取镜像，未生成 tar"
    return 0
  fi

  printf '%s\n' "$SINGLE_IMAGE" > "$ALL_LIST"

  render_export_progress 1 1 "拉取单镜像：$PLATFORM" "镜像" "$SINGLE_IMAGE"
  log_only "pull $SINGLE_IMAGE as $PLATFORM"
  if docker pull --platform "$PLATFORM" "$SINGLE_IMAGE" >> "$LOG" 2>&1; then
    local actual
    actual=$(platform_of_image "$SINGLE_IMAGE" 2>/dev/null || true)
    if platform_matches "$actual" "$PLATFORM"; then
      printf '%s\n' "$SINGLE_IMAGE" > "$EXPORT_LIST"
      log_only "ok $SINGLE_IMAGE => $actual"
    else
      append_skip "$SINGLE_IMAGE" "pulled platform is ${actual:-unknown}, expected $PLATFORM"
      step_done "单镜像检查完成：平台不匹配，未导出"
      return 2
    fi
  else
    local actual
    log_only "pull failed; checking local image $SINGLE_IMAGE"
    actual=$(platform_of_image "$SINGLE_IMAGE" 2>/dev/null || true)
    if [[ -z "$actual" ]]; then
      append_skip "$SINGLE_IMAGE" "docker pull --platform $PLATFORM failed and local image was not found"
      step_done "单镜像拉取失败，且本地未找到该镜像，未导出"
      return 2
    fi
    if platform_matches "$actual" "$PLATFORM"; then
      printf '%s\n' "$SINGLE_IMAGE" > "$EXPORT_LIST"
      log_only "local fallback ok $SINGLE_IMAGE => $actual"
      step_done "远端拉取失败，已使用本地已有镜像继续导出：$actual"
    else
      append_skip "$SINGLE_IMAGE" "docker pull --platform $PLATFORM failed; local platform is ${actual:-unknown}, expected $PLATFORM"
      step_done "单镜像拉取失败；本地镜像平台为 ${actual:-unknown}，不匹配 $PLATFORM，未导出"
      return 2
    fi
  fi

  rm -f "$OUT"
  if ! save_images_with_progress "$OUT" "$SINGLE_IMAGE"; then
    log "docker save failed: $OUT"
    return 2
  fi
  ls -lh "$OUT" >> "$LOG" 2>&1
  step_done "单镜像包已生成：$OUT"
  restore_tags
}

show_tar_tags() {
  local tar_file="$1"
  tar -xOf "$tar_file" repositories 2>/dev/null | python3 -c '
import json, sys
try:
    data=json.load(sys.stdin)
except Exception:
    sys.exit(0)
for repo, tags in data.items():
    for tag in tags:
        print(f"{repo}:{tag}")
' || true
}

validate_import_archive() {
  local tar_file="$1"

  require_cmd tar

  if ! tar -tf "$tar_file" >/dev/null 2>&1; then
    echo "镜像包无法读取：$tar_file" >&2
    echo "处理建议：请确认文件是否完整传输，或重新导出镜像包。" >&2
    return 2
  fi

  local python_bin=""
  if command -v python3 >/dev/null 2>&1 && python3 -c 'import sys' >/dev/null 2>&1; then
    python_bin="python3"
  elif command -v python >/dev/null 2>&1 && python -c 'import sys' >/dev/null 2>&1; then
    python_bin="python"
  fi

  if [[ -z "$python_bin" ]]; then
    echo "提示：未检测到可用 Python，已完成 tar 可读性检查，跳过 blob 引用深度校验。"
    return 0
  fi

  PYTHONIOENCODING=UTF-8 "$python_bin" - "$tar_file" <<'PY'
import json
import sys
import tarfile

archive = sys.argv[1]

def blob_path(digest):
    if not digest:
        return None
    if digest.startswith("sha256:"):
        return "blobs/sha256/" + digest.split(":", 1)[1]
    return digest

def read_json(tf, name):
    try:
        member = members.get(name)
        if member is None:
            return None
        item = tf.extractfile(member)
        if item is None:
            return None
        return json.load(item)
    except KeyError:
        return None
    except Exception as exc:
        print(f"镜像包 JSON 无法解析：{name}：{exc}", file=sys.stderr)
        sys.exit(2)

try:
    with tarfile.open(archive, "r") as tf:
        members = {}
        for item in tf.getmembers():
            name = item.name
            while name.startswith("./"):
                name = name[2:]
            members[name] = item
        missing = []
        bad_size = []

        def require(name, expected_size=None, where=""):
            if not name:
                return
            item = members.get(name)
            if item is None:
                missing.append((name, where))
                return
            if expected_size is not None and item.size != expected_size:
                bad_size.append((name, item.size, expected_size, where))

        # Docker save 的 manifest.json。
        manifest = read_json(tf, "manifest.json")
        if isinstance(manifest, list):
            for idx, item in enumerate(manifest):
                require(item.get("Config"), where=f"manifest.json[{idx}].Config")
                for layer in item.get("Layers", []):
                    require(layer, where=f"manifest.json[{idx}].Layers")
                for digest, source in item.get("LayerSources", {}).items():
                    require(
                        blob_path(source.get("digest", digest)),
                        source.get("size"),
                        f"manifest.json[{idx}].LayerSources",
                    )

        # Docker 新版本/containerd image store 导出的 OCI index。
        index = read_json(tf, "index.json")
        if isinstance(index, dict):
            for idx, desc in enumerate(index.get("manifests", [])):
                manifest_path = blob_path(desc.get("digest"))
                require(manifest_path, desc.get("size"), f"index.json.manifests[{idx}]")
                image_manifest = read_json(tf, manifest_path) if manifest_path in members else None
                if isinstance(image_manifest, dict):
                    config = image_manifest.get("config", {})
                    require(
                        blob_path(config.get("digest")),
                        config.get("size"),
                        f"{manifest_path}.config",
                    )
                    for layer_idx, layer in enumerate(image_manifest.get("layers", [])):
                        require(
                            blob_path(layer.get("digest")),
                            layer.get("size"),
                            f"{manifest_path}.layers[{layer_idx}]",
                        )

        if missing or bad_size:
            print("镜像包结构不完整，Docker load 会失败。", file=sys.stderr)
            for name, where in missing[:10]:
                print(f"缺少文件：{name}（引用位置：{where}）", file=sys.stderr)
            for name, actual, expected, where in bad_size[:10]:
                print(
                    f"文件大小不匹配：{name} 当前 {actual}，期望 {expected}（引用位置：{where}）",
                    file=sys.stderr,
                )
            print("处理建议：请重新拷贝镜像包，或在源机器重新导出；传输前后可用 sha256sum 比对。", file=sys.stderr)
            sys.exit(2)
except tarfile.TarError as exc:
    print(f"镜像包无法读取：{archive}：{exc}", file=sys.stderr)
    sys.exit(2)
PY
}

import_images() {
  cd "$WORKDIR"

  if [[ ! -f "$IMPORT_FILE" ]]; then
    echo "导入文件不存在：$IMPORT_FILE" >&2
    return 66
  fi

  if [[ "$DRY_RUN" == true ]]; then
    echo "dry-run would load $IMPORT_FILE"
    if [[ "$SHOW_IMAGES_AFTER_IMPORT" == true ]]; then
      show_tar_tags "$IMPORT_FILE" || true
    fi
    if [[ "$RUN_COMPOSE_UP" == true ]]; then
      echo "dry-run would run docker compose up -d in $WORKDIR"
    fi
    echo "步骤完成：导入预演完成，未执行 docker load"
    return 0
  fi

  require_cmd docker
  validate_import_archive "$IMPORT_FILE"
  echo "步骤完成：镜像包预检通过：$IMPORT_FILE"
  echo "开始导入镜像包：$IMPORT_FILE"
  docker load -i "$IMPORT_FILE"
  echo "步骤完成：镜像包已导入：$IMPORT_FILE"

  if [[ "$SHOW_IMAGES_AFTER_IMPORT" == true ]]; then
    echo "导入包包含的 tag："
    show_tar_tags "$IMPORT_FILE" || true
  fi

  if [[ "$RUN_COMPOSE_UP" == true ]]; then
    echo "执行 docker compose up -d"
    docker compose up -d
  fi
}

status_line() {
  local label="$1"
  local state="$2"
  local detail="$3"
  printf '  %-22s [%s] %s\n' "$label" "$state" "$detail"
}

check_environment() {
  echo "环境检查"
  echo "----------------------------------------"
  echo "工具信息"
  status_line "工具名称" "OK" "$SCRIPT_TITLE"
  status_line "脚本名称" "OK" "$SCRIPT_NAME"
  status_line "当前版本" "OK" "$SCRIPT_VERSION"
  status_line "目标架构" "OK" "$PLATFORM"
  echo

  echo "运行环境"
  if command -v docker >/dev/null 2>&1; then
    status_line "Docker 客户端" "OK" "$(docker --version 2>/dev/null || echo '已安装')"
  else
    status_line "Docker 客户端" "MISS" "未检测到 docker 命令"
  fi

  if command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
    status_line "Docker Compose" "OK" "$(docker compose version 2>/dev/null)"
  else
    status_line "Docker Compose" "MISS" "未检测到 docker compose"
  fi
  echo

  echo "项目路径"
  if [[ -d "$WORKDIR" ]]; then
    status_line "工作目录" "OK" "$WORKDIR"
  else
    status_line "工作目录" "MISS" "$WORKDIR 不存在"
  fi

  if [[ -f "$WORKDIR/docker-compose.yml" ]]; then
    status_line "docker-compose.yml" "OK" "$WORKDIR/docker-compose.yml"
  elif [[ -f "$WORKDIR/compose.yml" ]]; then
    status_line "docker-compose.yml" "OK" "$WORKDIR/compose.yml"
  else
    status_line "docker-compose.yml" "MISS" "未找到 compose 文件"
  fi
  echo

  echo "镜像迁移"
  if [[ -d "$WORKDIR" ]]; then
    local tar_count
    tar_count=$(find "$WORKDIR" -maxdepth 1 -type f -name '*.tar' 2>/dev/null | wc -l | tr -d ' ')
    status_line "镜像包文件" "OK" "${tar_count} 个 tar 文件"

    if command -v docker >/dev/null 2>&1 && [[ -f "$WORKDIR/docker-compose.yml" || -f "$WORKDIR/compose.yml" ]]; then
      local image_count
      image_count=$(cd "$WORKDIR" && docker compose config 2>/dev/null | awk '/image:/ {print $2}' | sort -u | wc -l | tr -d ' ')
      status_line "Compose 镜像数量" "OK" "${image_count} 个"
    else
      status_line "Compose 镜像数量" "SKIP" "缺少 docker compose 或 compose 文件"
    fi
  else
    status_line "镜像包文件" "SKIP" "工作目录不存在"
    status_line "Compose 镜像数量" "SKIP" "工作目录不存在"
  fi

  echo "步骤完成：环境检查完成"
}

compose_file_ready() {
  [[ -f "$WORKDIR/docker-compose.yml" || -f "$WORKDIR/compose.yml" ]]
}

show_service_status() {
  echo "服务状态"
  echo "----------------------------------------"
  echo "工作目录：$WORKDIR"
  echo "执行命令：docker compose ps"

  if [[ ! -d "$WORKDIR" ]]; then
    echo "工作目录不存在：$WORKDIR" >&2
    return 66
  fi

  if ! compose_file_ready; then
    echo "未找到 docker-compose.yml 或 compose.yml" >&2
    return 66
  fi

