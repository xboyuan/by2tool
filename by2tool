#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_VERSION="v1.5.1"
SCRIPT_NAME="by2tool"
SCRIPT_OWNER="BoYuan"
SCRIPT_TITLE="BoYuan运维工具箱"

# ===== 默认配置区 =====
# 日常使用时只需要执行：./by2tool，然后按菜单选择功能模块。
# 如果换系统、换目录、换默认架构，优先改这里的默认值。
# 外部也可以临时覆盖：
#   PLATFORM=linux/arm64 ./by2tool --mode export
#   ./by2tool --mode export-one --image harbor.kocel.com:8082/ktmp/tmp-ai:1.0.0
#   ./by2tool --mode import --in support_all_images_arm64.tar

# 默认操作：menu 表示进入交互菜单；也可以外部指定 export、import、update。
MODE="${MODE:-menu}"

# docker-compose.yml 所在目录。
WORKDIR="${WORKDIR:-/home/data/jar}"

# 目标系统架构。默认导出 x86/amd64；给 ARM 系统做包时可在菜单里选择，或外部指定 linux/arm64。
PLATFORM="${PLATFORM:-linux/amd64}"

# 导出完成后，把当前测试机上的同名镜像 tag 拉回这个架构，避免 x86 测试环境留下 ARM 镜像。
RESTORE_PLATFORM="${RESTORE_PLATFORM:-linux/amd64}"

# 导出的 docker save 包名。留空时会按 PLATFORM 自动生成，例如 support_all_images_amd64.tar。
OUT="${OUT:-}"

# 导出包格式。docker 表示兼容老版本 docker load 的 Docker archive；oci 保留 Docker 27+ 默认 OCI 风格。
EXPORT_ARCHIVE_FORMAT="${EXPORT_ARCHIVE_FORMAT:-docker}"

# 导入的 tar 文件。留空时默认使用 OUT。
IMPORT_FILE="${IMPORT_FILE:-}"

# 只导出单个镜像时使用的镜像名。
SINGLE_IMAGE="${SINGLE_IMAGE:-}"

# 批量导出时只处理这个仓库前缀下的镜像；单镜像导出以用户输入为准，不受此前缀限制。
# 如果批量导出希望处理所有带 / 的镜像，把它设置为空：REGISTRY_PREFIX=""
REGISTRY_PREFIX="${REGISTRY_PREFIX:-harbor.kocel.com:8082/}"

# 批量导出时需要排除的镜像规则，支持精确镜像名和 * 通配符；多个规则用逗号分隔。
# 例如：EXCLUDE_IMAGES="harbor.kocel.com:8082/ktmp/tmp-ai:1.0.0,harbor.kocel.com:8082/legacy/*"
EXCLUDE_IMAGES="${EXCLUDE_IMAGES:-}"

# true：导出成功后，只恢复本次实际导出的镜像；默认不恢复，避免额外改动本机镜像。
RESTORE_AFTER_EXPORT="${RESTORE_AFTER_EXPORT:-false}"

# 导入后是否显示导入包里的 RepoTags。
SHOW_IMAGES_AFTER_IMPORT="${SHOW_IMAGES_AFTER_IMPORT:-true}"

# 导入后是否执行 docker compose up -d。默认 false，避免导入镜像时顺手改变运行状态。
RUN_COMPOSE_UP="${RUN_COMPOSE_UP:-false}"

# 自动更新源。默认直接使用 GitHub；也可以临时指定 URL 或本机文件路径。
GITHUB_UPDATE_SOURCE="${GITHUB_UPDATE_SOURCE:-https://raw.githubusercontent.com/xboyuan/by2tool/main/by2tool}"
UPDATE_SOURCE="${UPDATE_SOURCE:-github}"

# 如果为空，则从 docker compose config 解析镜像列表；如果指定文件，则使用该文件里的镜像列表。
IMAGE_LIST="${IMAGE_LIST:-}"

# 中间文件和日志文件名。留空时会按 PLATFORM 自动生成。
ALL_LIST="${ALL_LIST:-images.list}"
EXPORT_LIST="${EXPORT_LIST:-}"
SKIP_LIST="${SKIP_LIST:-}"
LOG="${LOG:-}"

# true：只预演，不执行 docker pull、docker save、docker load、docker compose up。
DRY_RUN="${DRY_RUN:-false}"
PRINT_CONFIG="${PRINT_CONFIG:-false}"
INTERACTIVE=false
OUT_WAS_SET=false
IMPORT_FILE_WAS_SET=false
[[ -n "$OUT" ]] && OUT_WAS_SET=true
[[ -n "$IMPORT_FILE" ]] && IMPORT_FILE_WAS_SET=true


supports_color() {
  [[ -r /dev/tty && -w /dev/tty ]] && [[ "${TERM:-}" != "" ]] && [[ "${TERM:-}" != "dumb" ]] && [[ -z "${NO_COLOR:-}" ]]
}

if supports_color; then
  C_RESET=$'\033[0m'
  C_DIM=$'\033[2m'
  C_BOLD=$'\033[1m'
  C_CYAN=$'\033[36m'
  C_GREEN=$'\033[32m'
  C_YELLOW=$'\033[33m'
  C_REVERSE=$'\033[7m'
else
  C_RESET=""
  C_DIM=""
  C_BOLD=""
  C_CYAN=""
  C_GREEN=""
  C_YELLOW=""
  C_REVERSE=""
fi

usage() {
  cat <<'EOF'
用法：
  ./by2tool
  ./by2tool --mode export
#   ./by2tool --mode export-one --image harbor.kocel.com:8082/ktmp/tmp-ai:1.0.0
  ./by2tool --mode import --in support_all_images_arm64.tar
  ./by2tool --mode check
  ./by2tool --mode service-status
  ./by2tool --mode update

BoYuan运维工具箱采用单脚本交付，当前功能集中在“镜像迁移中心”。默认不传参数时进入 BoYuan 光标菜单。真实 SSH 终端中可用方向键选择，Enter 确认，q 退出；非 TTY 环境会自动回退为数字菜单。日常配置维护在脚本顶部的默认配置区；需要临时调整时，可以用环境变量或参数做外部覆盖。

常用示例：
  ./by2tool
  ./by2tool --mode export
#   ./by2tool --mode export-one --image harbor.kocel.com:8082/ktmp/tmp-ai:1.0.0
  PLATFORM=linux/arm64 ./by2tool --mode export
#   ./by2tool --mode export-one --image harbor.kocel.com:8082/ktmp/tmp-ai:1.0.0
  ./by2tool --mode import --in support_all_images_arm64.tar
  ./by2tool --mode check
  ./by2tool --mode service-status
  ./by2tool --mode export --dry-run
  ./by2tool --mode export --registry-prefix 'harbor.kocel.com:8082/*'
  ./by2tool --mode export --exclude-image 'harbor.kocel.com:8082/ktmp/tmp-ai:1.0.0'
  ./by2tool --mode export --registry-prefix 'harbor.kocel.com:8082/ktmp/*'

功能模块：
  镜像迁移中心          批量导出、多选导出、单个导出、导入镜像包
  导出范围              支持 Harbor 全仓库、项目路径前缀、自定义前缀筛选
  环境检查              检查 Docker、Compose、工作目录、compose 文件和镜像包
  服务启停              查看服务状态，带确认地执行启动、停止、重启

可选参数：
  --interactive            强制进入交互菜单
  --mode MODE              操作模式：menu、export、export-one、import、check、service-status、update
  --workdir DIR            docker-compose.yml 所在目录
  --platform PLATFORM      目标导出架构，例如 linux/amd64、linux/arm64、linux/arm/v7
  --restore-platform P     导出完成后恢复当前机器镜像 tag 的架构
  --out FILE               输出的 docker save tar 文件；不指定则按平台自动生成
  --archive-format FORMAT  导出包格式：docker 兼容老 docker load，oci 保留原始 OCI 风格
  --in FILE                导入的 docker save tar 文件；不指定则默认使用 OUT
  --image IMAGE            只导出单个镜像时使用的镜像名
  --registry-prefix PREFIX 只处理指定仓库前缀；传空字符串可处理所有带 / 的镜像
  --exclude-image PATTERN  批量导出时排除镜像，支持 * 通配符；可重复使用
  --image-list FILE        使用指定镜像列表，不从 docker compose config 解析
  --restore                导出成功后恢复本次实际导出的镜像到 restore-platform
  --no-restore             导出后不恢复当前机器镜像架构
  --compose-up             导入后执行 docker compose up -d
  --no-show-images         导入后不显示导入包内的 RepoTags
  --update-source SRC      自动更新源，支持 github、URL 或本机文件路径
  --dry-run                只预演，不拉镜像、不保存/导入 tar、不启动 compose
  --print-config           打印最终生效配置并退出
  -h, --help               显示帮助

更新脚本说明：
  默认直接使用 GitHub Raw，也可以执行时传 --update-source 临时覆盖。
  更新前会备份当前脚本，并对新脚本执行 bash -n 语法检查；检查失败不会替换当前脚本。
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --interactive) INTERACTIVE=true; MODE=menu; shift ;;
    --mode) MODE="$2"; shift 2 ;;
    --workdir) WORKDIR="$2"; shift 2 ;;
    --platform) PLATFORM="$2"; shift 2 ;;
    --restore-platform) RESTORE_PLATFORM="$2"; shift 2 ;;
    --out) OUT="$2"; OUT_WAS_SET=true; shift 2 ;;
    --archive-format) EXPORT_ARCHIVE_FORMAT="$2"; shift 2 ;;
    --in) IMPORT_FILE="$2"; IMPORT_FILE_WAS_SET=true; shift 2 ;;
    --image) SINGLE_IMAGE="$2"; shift 2 ;;
    --registry-prefix) REGISTRY_PREFIX="$2"; shift 2 ;;
    --exclude-image)
      [[ -n "$EXCLUDE_IMAGES" ]] && EXCLUDE_IMAGES+=","
      EXCLUDE_IMAGES+="$2"
      shift 2
      ;;
    --image-list) IMAGE_LIST="$2"; shift 2 ;;
    --restore) RESTORE_AFTER_EXPORT=true; shift ;;
    --no-restore) RESTORE_AFTER_EXPORT=false; shift ;;
    --compose-up) RUN_COMPOSE_UP=true; shift ;;
    --no-show-images) SHOW_IMAGES_AFTER_IMPORT=false; shift ;;
    --update-source) UPDATE_SOURCE="$2"; shift 2 ;;
    --dry-run) DRY_RUN=true; shift ;;
    --print-config) PRINT_CONFIG=true; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "未知参数：$1" >&2; usage >&2; exit 64 ;;
  esac
done

normalize_registry_prefix() {
  local prefix="$1"
  prefix="${prefix%\"}"
  prefix="${prefix#\"}"
  prefix="${prefix%\'}"
  prefix="${prefix#\'}"
  if [[ "$prefix" == *'*' ]]; then
    prefix="${prefix%\*}"
  fi
  printf '%s' "$prefix"
}

REGISTRY_PREFIX="$(normalize_registry_prefix "$REGISTRY_PREFIX")"
EXPORT_ARCHIVE_FORMAT="${EXPORT_ARCHIVE_FORMAT,,}"
case "$EXPORT_ARCHIVE_FORMAT" in
  docker|oci) ;;
  *) echo "未知 EXPORT_ARCHIVE_FORMAT：$EXPORT_ARCHIVE_FORMAT，仅支持 docker 或 oci" >&2; exit 64 ;;
esac

platform_suffix() {
  local platform="$1"
  platform="${platform#linux/}"
  platform="${platform//\//_}"
  printf '%s' "$platform"
}

single_image_default_out() {
  local image="$1"
  image="${image//\//_}"
  image="${image//:/_}"
  image="${image//@/_}"
  printf 'single_%s_%s.tar' "$image" "$(platform_suffix "$PLATFORM")"
}

apply_derived_defaults() {
  PLATFORM_SUFFIX="$(platform_suffix "$PLATFORM")"
  if [[ "$MODE" == "export-one" && -n "$SINGLE_IMAGE" && "$OUT_WAS_SET" != true ]]; then
    OUT="$(single_image_default_out "$SINGLE_IMAGE")"
  elif [[ "$MODE" == "export-selected" && "$OUT_WAS_SET" != true ]]; then
    OUT="${OUT:-selected_images_${PLATFORM_SUFFIX}.tar}"
  else
    OUT="${OUT:-support_all_images_${PLATFORM_SUFFIX}.tar}"
  fi
  IMPORT_FILE="${IMPORT_FILE:-$OUT}"
  if [[ "$MODE" == "export-one" ]]; then
    EXPORT_LIST="${EXPORT_LIST:-single_${PLATFORM_SUFFIX}_export_images.list}"
    SKIP_LIST="${SKIP_LIST:-single_${PLATFORM_SUFFIX}_skipped_images.list}"
    LOG="${LOG:-single_${PLATFORM_SUFFIX}_export.log}"
  elif [[ "$MODE" == "export-selected" ]]; then
    EXPORT_LIST="${EXPORT_LIST:-selected_${PLATFORM_SUFFIX}_export_images.list}"
    SKIP_LIST="${SKIP_LIST:-selected_${PLATFORM_SUFFIX}_skipped_images.list}"
    LOG="${LOG:-selected_${PLATFORM_SUFFIX}_export.log}"
  else
    EXPORT_LIST="${EXPORT_LIST:-${PLATFORM_SUFFIX}_export_images.list}"
    SKIP_LIST="${SKIP_LIST:-${PLATFORM_SUFFIX}_skipped_images.list}"
    LOG="${LOG:-${PLATFORM_SUFFIX}_export.log}"
  fi
}

apply_derived_defaults

reset_platform_derived_names() {
  OUT=""
  IMPORT_FILE=""
  EXPORT_LIST=""
  SKIP_LIST=""
  LOG=""
  OUT_WAS_SET=false
  IMPORT_FILE_WAS_SET=false
  apply_derived_defaults
}

print_config() {
  cat <<EOF
SCRIPT_VERSION=$SCRIPT_VERSION
SCRIPT_NAME=$SCRIPT_NAME
MODE=$MODE
SCRIPT_TITLE=$SCRIPT_TITLE
WORKDIR=$WORKDIR
PLATFORM=$PLATFORM
RESTORE_PLATFORM=$RESTORE_PLATFORM
OUT=$OUT
EXPORT_ARCHIVE_FORMAT=$EXPORT_ARCHIVE_FORMAT
IMPORT_FILE=$IMPORT_FILE
SINGLE_IMAGE=$SINGLE_IMAGE
REGISTRY_PREFIX=$REGISTRY_PREFIX
EXCLUDE_IMAGES=$EXCLUDE_IMAGES
RESTORE_AFTER_EXPORT=$RESTORE_AFTER_EXPORT
SHOW_IMAGES_AFTER_IMPORT=$SHOW_IMAGES_AFTER_IMPORT
RUN_COMPOSE_UP=$RUN_COMPOSE_UP
UPDATE_SOURCE=$UPDATE_SOURCE
GITHUB_UPDATE_SOURCE=$GITHUB_UPDATE_SOURCE
IMAGE_LIST=$IMAGE_LIST
ALL_LIST=$ALL_LIST
EXPORT_LIST=$EXPORT_LIST
SKIP_LIST=$SKIP_LIST
LOG=$LOG
DRY_RUN=$DRY_RUN
EOF
}

if [[ "$PRINT_CONFIG" == true ]]; then
  print_config
  exit 0
fi

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "缺少必要命令：$1" >&2
    exit 127
  }
}

log() {
  printf '[%s] %s\n' "$(date '+%F %T')" "$*" | tee -a "$LOG"
}

log_only() {
  printf '[%s] %s\n' "$(date '+%F %T')" "$*" >> "$LOG"
}

step_done() {
  local message="$1"
  if [[ -n "${LOG:-}" ]]; then
    log "步骤完成：$message"
  else
    echo "步骤完成：$message"
  fi
}

progress_bar() {
  local current="$1"
  local total="$2"
  local width=28
  local percent=0
  local filled=0
  local empty=0
  local bar=""
  local i

  if (( total > 0 )); then
    percent=$((current * 100 / total))
  fi
  (( percent > 100 )) && percent=100
  filled=$((percent * width / 100))
  empty=$((width - filled))

  for ((i = 0; i < filled; i++)); do
    bar+="█"
  done
  for ((i = 0; i < empty; i++)); do
    bar+="░"
  done
  printf '%s' "$bar"
}

render_export_progress() {
  local current="$1"
  local total="$2"
  local stage="$3"
  local detail_label="$4"
  local detail="$5"
  local percent=0
  local bar

  progress_rewind

  if (( total > 0 )); then
    percent=$((current * 100 / total))
  fi
  (( percent > 100 )) && percent=100
  bar="$(progress_bar "$current" "$total")"

  printf '%b\n' "${C_CYAN}┌─ 导出进度${C_RESET}"
  printf '  %b[%s]%b %3d%%  %d/%d\n' "$C_CYAN" "$bar" "$C_RESET" "$percent" "$current" "$total"
  printf '  阶段：%s\n' "$stage"
  printf '  当前%s：%s\n' "$detail_label" "$detail"
  printf '%b\n' "${C_CYAN}└────────────────────────────────────────${C_RESET}"

  progress_mark_rendered 5
}

progress_can_refresh() {
  [[ -t 1 ]] || [[ "${BY2_FORCE_TTY_PROGRESS:-false}" == true ]]
}

progress_rewind() {
  if [[ "${BY2_PROGRESS_RENDERED:-false}" == true ]] && progress_can_refresh; then
    printf '\033[%sA' "${BY2_PROGRESS_LINES:-5}"
  fi
}

progress_mark_rendered() {
  local lines="$1"
  if progress_can_refresh; then
    printf '\033[J'
    BY2_PROGRESS_RENDERED=true
    BY2_PROGRESS_LINES="$lines"
  fi
}

format_elapsed() {
  local start="$1"
  local now
  local elapsed
  now=$(date +%s)
  elapsed=$((now - start))
  printf '%02d:%02d:%02d' "$((elapsed / 3600))" "$(((elapsed % 3600) / 60))" "$((elapsed % 60))"
}

human_file_size() {
  local file="$1"
  local bytes=0
  if [[ -e "$file" ]]; then
    bytes=$(stat -c '%s' "$file" 2>/dev/null || echo 0)
  fi
  awk -v bytes="$bytes" 'BEGIN {
    split("B KiB MiB GiB TiB", unit)
    size = bytes + 0
    idx = 1
    while (size >= 1024 && idx < 5) {
      size = size / 1024
      idx++
    }
    if (idx == 1) {
      printf "%d%s", size, unit[idx]
    } else {
      printf "%.2f%s", size, unit[idx]
    }
  }'
}

find_python_bin() {
  if command -v python3 >/dev/null 2>&1 && python3 -c 'import sys' >/dev/null 2>&1; then
    printf 'python3'
    return 0
  fi
  if command -v python >/dev/null 2>&1 && python -c 'import sys' >/dev/null 2>&1; then
    printf 'python'
    return 0
  fi
  return 1
}

convert_oci_archive_to_docker_archive() {
  local source_tar="$1"
  local target_tar="$2"
  local python_bin

  python_bin="$(find_python_bin)" || {
    echo "缺少可用 Python，无法把 OCI 风格镜像包转换为兼容 Docker archive。" >&2
    echo "处理建议：安装 python3，或临时设置 EXPORT_ARCHIVE_FORMAT=oci 保留原始格式。" >&2
    return 127
  }

  PYTHONIOENCODING=UTF-8 "$python_bin" - "$source_tar" "$target_tar" <<'PY'
import copy
import hashlib
import io
import json
import shutil
import sys
import tarfile

source, target = sys.argv[1], sys.argv[2]

def normalize(name):
    while name.startswith("./"):
        name = name[2:]
    return name

def add_bytes(tf, name, data, mode=0o644):
    raw = data if isinstance(data, bytes) else data.encode("utf-8")
    info = tarfile.TarInfo(name)
    info.size = len(raw)
    info.mode = mode
    info.mtime = 0
    tf.addfile(info, io.BytesIO(raw))

def add_dir(tf, name, dirs):
    name = name.rstrip("/")
    if not name or name in dirs:
        return
    parent = name.rsplit("/", 1)[0] if "/" in name else ""
    if parent:
        add_dir(tf, parent, dirs)
    info = tarfile.TarInfo(name + "/")
    info.type = tarfile.DIRTYPE
    info.mode = 0o755
    info.mtime = 0
    tf.addfile(info)
    dirs.add(name)

def split_repo_tag(repo_tag):
    slash = repo_tag.rfind("/")
    colon = repo_tag.rfind(":")
    if colon <= slash:
        return None, None
    return repo_tag[:colon], repo_tag[colon + 1:]

with tarfile.open(source, "r") as src:
    members = {}
    for item in src.getmembers():
        members[normalize(item.name)] = item

    manifest_member = members.get("manifest.json")
    if manifest_member is None:
        shutil.copyfile(source, target)
        sys.exit(0)

    manifest = json.load(src.extractfile(manifest_member))
    if not isinstance(manifest, list):
        shutil.copyfile(source, target)
        sys.exit(0)

    needs_convert = "oci-layout" in members or any(
        str(item.get("Config", "")).startswith("blobs/")
        or any(str(layer).startswith("blobs/") for layer in item.get("Layers", []))
        for item in manifest
    )
    if not needs_convert:
        shutil.copyfile(source, target)
        sys.exit(0)

    output_manifest = []
    repositories = {}
    added_layers = set()
    added_dirs = set()
    added_configs = set()

    with tarfile.open(target, "w") as out:
        for image_index, item in enumerate(manifest):
            config_path = normalize(item.get("Config", ""))
            config_member = members.get(config_path)
            if config_member is None:
                raise SystemExit(f"missing config blob: {config_path}")

            config_base = config_path.rsplit("/", 1)[-1]
            config_name = f"{config_base}.json"
            if config_name not in added_configs:
                config_file = src.extractfile(config_member)
                if config_file is None:
                    raise SystemExit(f"cannot read config blob: {config_path}")
                info = tarfile.TarInfo(config_name)
                info.size = config_member.size
                info.mode = 0o644
                info.mtime = 0
                out.addfile(info, config_file)
                added_configs.add(config_name)

            parent = ""
            converted_layers = []
            for layer_index, layer_path in enumerate(item.get("Layers", [])):
                layer_path = normalize(layer_path)
                layer_member = members.get(layer_path)
                if layer_member is None:
                    raise SystemExit(f"missing layer blob: {layer_path}")

                layer_key = layer_path.rsplit("/", 1)[-1]
                chain_id = hashlib.sha256(f"{parent}\n{layer_key}".encode("utf-8")).hexdigest()
                layer_dir = chain_id
                layer_tar = f"{layer_dir}/layer.tar"

                if chain_id not in added_layers:
                    add_dir(out, layer_dir, added_dirs)
                    add_bytes(out, f"{layer_dir}/VERSION", "1.0\n")
                    layer_meta = {"id": layer_dir}
                    if parent:
                        layer_meta["parent"] = parent
                    add_bytes(out, f"{layer_dir}/json", json.dumps(layer_meta, separators=(",", ":")) + "\n")

                    layer_file = src.extractfile(layer_member)
                    if layer_file is None:
                        raise SystemExit(f"cannot read layer blob: {layer_path}")
                    info = tarfile.TarInfo(layer_tar)
                    info.size = layer_member.size
                    info.mode = 0o644
                    info.mtime = 0
                    out.addfile(info, layer_file)
                    added_layers.add(chain_id)

                converted_layers.append(layer_tar)
                parent = layer_dir

            repo_tags = [tag for tag in item.get("RepoTags", []) if tag and tag != "<none>:<none>"]
            for repo_tag in repo_tags:
                repo, tag = split_repo_tag(repo_tag)
                if repo and tag and parent:
                    repositories.setdefault(repo, {})[tag] = parent

            new_item = copy.deepcopy(item)
            new_item["Config"] = config_name
            new_item["Layers"] = converted_layers
            output_manifest.append(new_item)

        add_bytes(out, "manifest.json", json.dumps(output_manifest, separators=(",", ":")) + "\n")
        add_bytes(out, "repositories", json.dumps(repositories, separators=(",", ":")) + "\n")
PY
}

render_packaging_progress() {
  local out_file="$1"
  local signal="$2"
  local start_time="$3"
  local elapsed
  local size

  elapsed="$(format_elapsed "$start_time")"
  size="$(human_file_size "$out_file")"
  progress_rewind
  printf '%b\n' "${C_CYAN}┌─ 生成镜像包中 ${signal}${C_RESET}"
  printf '  输出文件：%s\n' "$out_file"
  printf '  已耗时：%s\n' "$elapsed"
  printf '  当前大小：%s\n' "$size"
  printf '  状态：docker save 正在写入镜像包，请勿关闭终端\n'
  printf '%b\n' "${C_CYAN}└────────────────────────────────────────${C_RESET}"
  progress_mark_rendered 6
}

save_images_with_progress() {
  local out_file="$1"
  shift
  local start_time
  local pid
  local rc=0
  local spin='|/-\'
  local index=0
  local signal

  start_time="$(date +%s)"
  signal="${spin:$((index % 4)):1}"
  render_packaging_progress "$out_file" "$signal" "$start_time"
  log_only "saving $out_file"

  docker save "$@" -o "$out_file" >> "$LOG" 2>&1 &
  pid=$!

  while kill -0 "$pid" 2>/dev/null; do
    index=$((index + 1))
    signal="${spin:$((index % 4)):1}"
    if progress_can_refresh; then
      render_packaging_progress "$out_file" "$signal" "$start_time"
    fi
    sleep 1
  done

  if wait "$pid"; then
    rc=0
  else
    rc=$?
  fi

  render_packaging_progress "$out_file" "OK" "$start_time"

  if [[ "$rc" -eq 0 && "$EXPORT_ARCHIVE_FORMAT" == "docker" ]]; then
    local converted_file
    converted_file="${out_file}.docker-archive.$$"
    log_only "converting $out_file to docker-compatible archive"
    if convert_oci_archive_to_docker_archive "$out_file" "$converted_file" >> "$LOG" 2>&1; then
      mv -f "$converted_file" "$out_file"
      step_done "镜像包已转换为兼容 Docker archive 格式，可在老版本 docker load 中导入"
    else
      rm -f "$converted_file"
      echo "镜像包格式转换失败：$out_file" >&2
      return 2
    fi
  elif [[ "$rc" -eq 0 ]]; then
    step_done "镜像包保留 OCI 风格格式"
  fi

  return "$rc"
}

append_skip() {
  local image="$1"
  local reason="$2"
  printf '%s | skipped: %s\n' "$image" "$reason" | tee -a "$SKIP_LIST" "$LOG" >/dev/null
}

platform_of_image() {
  docker image inspect "$1" --format '{{.Os}}/{{.Architecture}}{{if .Variant}}/{{.Variant}}{{end}}'
}

platform_matches() {
  local actual="$1"
  local expected="$2"

  [[ "$actual" == "$expected" ]] && return 0

  # Docker 有时只显示 linux/arm64，而 Harbor 页面可能显示 linux/arm64/v8；这两种按 ARM64 兼容处理。
  if [[ "$expected" == "linux/arm64" && "$actual" == "linux/arm64/v8" ]]; then
    return 0
  fi

  return 1
}

is_registry_image() {
  local image="$1"

  # 多选导出与单镜像导出语义一致，用户明确选中的 Compose 镜像不再受仓库前缀限制。
  if [[ "$MODE" == "export-selected" ]]; then
    return 0
  fi

  # 设置了仓库前缀时，只处理该前缀下的镜像。
  if [[ -n "$REGISTRY_PREFIX" ]]; then
    [[ "$image" == "$REGISTRY_PREFIX"* ]]
    return
  fi

  # 没有仓库前缀时，处理所有带 / 的镜像；tmp-base:1.0.0 这类本地短名仍然跳过。
  [[ "$image" == */* ]]
}

is_excluded_image() {
  local image="$1"
  local pattern
  local patterns="${EXCLUDE_IMAGES//,/$'\n'}"

  while IFS= read -r pattern; do
    pattern="${pattern#"${pattern%%[![:space:]]*}"}"
    pattern="${pattern%"${pattern##*[![:space:]]}"}"
    [[ -n "$pattern" ]] || continue

    if [[ "$image" == $pattern ]]; then
      return 0
    fi
  done <<< "$patterns"

  return 1
}

describe_export_scope() {
  if [[ "$MODE" == "export-one" ]]; then
    printf '单个镜像，不使用仓库前缀过滤'
    return
  fi

  if [[ "$MODE" == "export-selected" ]]; then
